# OneQuickJob environment. Copy to .env (`make env` does it and fills in the secrets).
# Every worktree has its own .env. Lane N uses API_PORT=800N, WEB_PORT=517N and
# MONGO_DB=oqj_lN; main uses 8000, 5170 and oqj_main. All share one Mongo container.
# Values are read by Docker Compose: quote any value containing $ with single quotes.

# --- this worktree -----------------------------------------------------------
APP_ENV=dev
DEMO_MODE=true
API_PORT=8000
WEB_PORT=5170
MONGO_DB=oqj_main
MONGO_URL=mongodb://oqj-mongo:27017
# Links in outbox messages start with this. The Outbox drawer opens them on whatever
# address you're using, so lanes viewed through an SSH tunnel work unchanged.
PUBLIC_BASE_URL=https://dev.onequickjob.co.uk
# Long and random: peppers code/token hashes and seals tax identifiers.
SECRET_KEY=
COOKIE_SECURE=true
TASKS_ENABLED=true

# --- money (integer pence everywhere; rates are decimals) ---------------------
FEE_STANDARD_RATE=0.15
FEE_OWN_RATE=0.05
FEE_OWN_MIN_PENCE=100

# --- adapters (fakes unless configured) ---------------------------------------
PAYMENT_GATEWAY=fake
# Test keys only (sk_test_..., pk_test_...). Lane L3 adds the Stripe gateway.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to use Ideal Postcodes (server-side only); empty uses the fake address list.
IDEAL_POSTCODES_KEY=
AREA_ESTIMATOR=manual_bands_v0

# --- Caddy (shared by all worktrees; main's values are the ones in use) --------
SITE_HOST=dev.onequickjob.co.uk
BASIC_AUTH_USER=oqj
BASIC_AUTH_PASSWORD=
CADDY_WEB_UPSTREAM=oqj-main-web:5173
CADDY_API_UPSTREAM=oqj-main-api:8000
CADDY_FILES_VOLUME=oqj-files-main
