# Installed by make backup-timer (scripts/install-backup-timer.sh fills in @USER@ and @ROOT@).
[Unit]
Description=OneQuickJob: back up the demo database (mongodump into /srv/oqj/backups)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=@USER@
Group=@USER@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/scripts/backup.sh
