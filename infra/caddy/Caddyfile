# Private prototype: HTTPS (automatic, Let's Encrypt) and basic auth on EVERYTHING,
# including /files. Credentials come from .env (BASIC_AUTH_USER, BASIC_AUTH_PASSWORD);
# entrypoint.sh hashes the password at start-up.
#
# Production-style (make prod-up): the built web app from /srv/www (var/www on the host), the
# production API (oqj-prod-api) for /api, uploads from the files volume. No dev server is
# involved; `make dev` is reached through an SSH tunnel to its loopback ports instead.
{
	servers {
		# HTTP/3 would need UDP 443, which the firewall doesn't open.
		protocols h1 h2
	}
}

{$SITE_HOST} {
	encode zstd gzip

	# Access log to stdout (docker logs oqj-caddy; Docker keeps 5 x 10 MB, compose.shared.yml).
	# Caddy already writes Authorization, Cookie and Set-Cookie as REDACTED; the filters take
	# the single-use tokens out of links (invites, plan changes, job alerts' ?t=) too. make e2e's
	# basic-auth check reads it for 401s.
	log {
		output stdout
		format filter {
			request>uri regexp "(/(?:invite|invites|plan-change|plan-changes)/)[^/?#]+|([?&]t=)[^&#]+" "${1}${2}REDACTED"
			request>headers>Referer regexp "(/(?:invite|invites|plan-change|plan-changes)/)[^/?#]+|([?&]t=)[^&#]+" "${1}${2}REDACTED"
		}
	}

	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# FileStore: photos and documents, straight from the volume.
	handle /files/* {
		root * /srv
		file_server
	}

	handle /api/* {
		reverse_proxy {$CADDY_API_UPSTREAM}
	}

	# The built app. Hashed assets never change, so browsers keep them; everything else (the
	# HTML shell, the provider app's manifest and service worker) is checked every time. Any
	# path that isn't a file is one of the app's routes: index.html renders it.
	handle {
		root * /srv/www
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
